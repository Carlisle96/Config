# Desktop-only mount reference; merge entries into /etc/fstab, do not replace it.
# Filesystem UUIDs survive an OS reinstall if the data partition is not reformatted.
# After reformatting or replacing a drive, check its UUID with lsblk -f.
# Both current SATA SSDs have the label "Data", so use their unique UUIDs.

# Samsung SSD 870 EVO 500GB, ext4 data partition.
# nofail allows booting without this drive connected.
UUID=d31436ac-5284-4f58-9916-b6ec0c5710af /home/thyriaen/Data ext4 defaults,nofail 0 2

# Historical Documents mount; not used on the current installation:
# LABEL=thy-documents /home/thyriaen/Documents ext4 defaults 0 2

# Previous UUID-based entries:
# UUID=d459de50-ebe4-4e64-9b63-a65b80d18ba6 /home/thyriaen/Data ext4 defaults 0 0
# UUID=3baa35ef-d65e-435a-827b-e6166993d36e /home/thyriaen/Documents ext4 defaults 0 0
