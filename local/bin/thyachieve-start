#!/usr/bin/env bash

eww daemon || exit 1

# Daemon startup returns before its IPC socket is ready.
if ! timeout --kill-after=2s 60s sh -c '
  until eww --no-daemonize ping >/dev/null 2>&1; do sleep 0.2; done
'; then
  printf 'thyachieve-start: Eww was not ready within 60 seconds\n' >&2
  exit 1
fi

eww --no-daemonize open achievements "$@"
eww --no-daemonize open achievements-full
thyachieve
